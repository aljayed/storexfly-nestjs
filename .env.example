# ─────────────────────────────────────────────────────────────
# StoreXFly API — environment template. Copy to `.env` and adjust.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated list of allowed browser origins (the Vue app).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# PostgreSQL (consumed by docker-compose.yml and the app)
POSTGRES_USER=storexfly
POSTGRES_PASSWORD=storexfly
POSTGRES_DB=storexfly
POSTGRES_PORT=5432
DATABASE_URL=postgres://storexfly:storexfly@localhost:5432/storexfly

# JWT — seller sessions
JWT_SECRET=change-me-in-production-seller-secret
JWT_EXPIRES_IN=7d

# JWT — admin console sessions (separate, stricter scope)
ADMIN_JWT_SECRET=change-me-in-production-admin-secret
ADMIN_JWT_EXPIRES_IN=12h
# Short-lived ticket issued between the credentials and 2FA stages.
ADMIN_2FA_TICKET_SECRET=change-me-in-production-2fa-ticket-secret
ADMIN_2FA_TICKET_EXPIRES_IN=5m

# Google OAuth (passport-google-oauth20). Leave blank to disable the Google routes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Where the Google callback redirects the browser back to (Vue app), token appended as ?token=
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback

# Throttling (auth-route rate limiting)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
