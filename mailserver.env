# docker-mailserver configuration — see https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/
OVERRIDE_HOSTNAME=mail.hoomri.com
POSTMASTER_ADDRESS=support@hoomri.com

SSL_TYPE=manual
SSL_CERT_PATH=/etc/letsencrypt/live/hoomri.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/hoomri.com/privkey.pem

ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=1
ENABLE_SPAMASSASSIN=1
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=1

ONE_DIR=1
PERMIT_DOCKER=network
